{"tag":"dark psychology","lines":[["How to make\nsomeone regret\nlosing you","serif_italic",100,"white"],["#3 is the hardest","sans",42,"gray"]],"dur":3.0},
{"tag":"step one","lines":[["Go silent.\nCompletely.","serif_italic",90,"white"],["No angry texts. No stories for them.\nSilence makes them wonder.","sans",38,"gray"]],"dur":3.4},
{"tag":"step two","lines":[["Glow up\nfor yourself.","serif_italic",90,"white"],["Not to show them.\nTo become someone new.","sans",42,"gray"]],"dur":3.4},
{"tag":"step three","lines":[["Don't hate them.\nForget them.","serif_italic",88,"white"],["Anger means they still matter.\nIndifference is what hurts.","sans",38,"gray"]],"dur":3.4},
{"tag":"step four","lines":[["Be happy\nwithout them.","serif_italic",90,"red"],["Nothing hits harder\nthan seeing you thrive.","sans",42,"gray"]],"dur":3.4}
